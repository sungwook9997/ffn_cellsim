{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-aleph.local/schemas/external-training-source-v1.json",
  "title": "Aleph external training source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "source_family_id", "title", "year", "doi", "canonical_url",
    "topic_tags", "aleph_roles", "access_route", "access_verified_at",
    "access_evidence", "license_status", "redistribution", "full_text_status",
    "extraction_status", "authority_status"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^EXT-[0-9]{4}$"},
    "source_family_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "doi": {"type": ["string", "null"]},
    "pmcid": {"type": ["string", "null"]},
    "canonical_url": {"type": "string", "format": "uri"},
    "topic_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "aleph_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["prior", "observable", "protocol", "baseline", "negative_evidence", "inference_method"]}},
    "access_route": {"enum": ["open_access", "institution_kaist", "metadata_only"]},
    "access_verified_at": {"type": ["string", "null"], "format": "date"},
    "access_evidence": {"type": "string"},
    "license_status": {"type": "string"},
    "redistribution": {"enum": ["permitted_by_recorded_license", "local_only", "unknown"]},
    "full_text_status": {"enum": ["accessible_not_archived", "queued", "metadata_only", "locally_archived"]},
    "payload_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "extraction_status": {"enum": ["queued", "in_progress", "extracted", "reviewed"]},
    "authority_status": {"const": "proposed"},
    "notes": {"type": "string"}
  }
}
