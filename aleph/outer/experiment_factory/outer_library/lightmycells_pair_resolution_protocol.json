  "deterministic_alignment_contract": {
    "ordered_rules": [
      {
        "when": "input stack has exactly one plane",
        "action": "select that plane regardless of PositionZ metadata",
        "alignment_method": "singleton_input"
      },
      {
        "when": "target PositionZ and first/last input PositionZ are all finite and use the same unit",
