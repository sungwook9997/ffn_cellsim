        "action": "select the lower median input plane after sorting by integer z index",
        "alignment_method": "lower_median_z_fallback"
      }
    ],
    "lower_median_index": "(number_of_input_planes - 1) // 2",
    "fallback_is_never_described_as_exact_registration": true,
