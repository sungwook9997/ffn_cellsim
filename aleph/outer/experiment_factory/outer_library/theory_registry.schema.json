{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outer.biophysics.theory_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "aleph_dependency", "theories"],
  "properties": {
    "schema": {"const": "outer.biophysics.theory_registry.v1"},
    "aleph_dependency": {"const": false},
    "theories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theory_id", "version", "status", "equations", "inputs", "outputs",
          "assumptions", "compatible_modalities", "geometry", "time_regime",
          "identifiable", "non_identifiable", "citation", "evidence_role",
          "implementation"
        ],
        "properties": {
          "theory_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["implemented", "planned"]},
          "equations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "object"}},
          "outputs": {"type": "array", "items": {"type": "object"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "compatible_modalities": {"type": "array", "items": {"type": "string"}},
          "geometry": {"type": "string"},
          "time_regime": {"type": "string"},
          "identifiable": {"type": "array", "items": {"type": "string"}},
          "non_identifiable": {"type": "array", "items": {"type": "string"}},
          "citation": {
            "type": "object",
            "required": ["title", "identifier"],
            "properties": {"title": {"type": "string"}, "identifier": {"type": "string"}}
          },
          "evidence_role": {"enum": ["constraint", "expert", "synthetic_generator"]},
          "implementation": {"type": ["string", "null"]}
        }
      }
    }
  }
}
