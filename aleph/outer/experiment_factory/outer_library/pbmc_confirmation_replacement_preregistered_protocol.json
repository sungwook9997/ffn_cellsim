{
  "schema": "aleph.outer_library.pbmc_confirmation_replacement_protocol.v1",
  "frozen_before_GSE158055_expression_or_cell_annotation_access": true,
  "objective": "replace the structurally refused GSE222647 confirmation source with a new untouched laboratory while preserving the original classifier and the independently frozen GSE164378 calibration role",
  "retired_source": {
    "accession": "GSE222647",
    "decision": "retired_before_model_execution",
    "reason": "the released donor and condition columns were Sample.Name and Study.Classification, neither of which was admitted by the frozen exact-column precedence; adding them after inspection would alter the confirmation protocol post hoc",
    "expression_used_for_model_prediction": false,
    "labels_used_for_metrics_selection_or_calibration": false,
    "may_be_reused_as_pristine_confirmation": false
  },
  "replacement_source": {
    "accession": "GSE158055",
    "lab_group": "Peking_University_Zhang_large_scale_COVID19_PBMC",
    "official_record": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE158055",
    "citation_pmid": "33657410",
    "expected_files": [
      "GSE158055_cell_annotation.csv.gz",
      "GSE158055_covid19_barcodes.tsv.gz",
      "GSE158055_covid19_counts.mtx.gz",
      "GSE158055_covid19_features.tsv.gz",
      "GSE158055_sample_metadata.xlsx"
    ],
    "official_design_known_before_file_access": "284 samples from 196 people, including 25 healthy controls; 249 PBMC samples plus non-PBMC tissues",
    "role": "single_use_untouched_confirmation"
  },
  "fixed_upstream_artifacts": {
    "classifier": "pbmc_cross_lab_model.npz",
    "classifier_training_dataset": "GSE96583",
    "feature_count": 508,
    "calibration_dataset": "GSE164378",
    "calibration_may_fit_only": ["one scalar temperature", "six class-conditional alpha-0.1 conformal thresholds"],
    "GSE132044_role": "opened retrospective diagnostic only"
  },
  "column_resolution_frozen_before_access": {
    "normalization": "Unicode casefold then remove every character except ASCII a-z and 0-9",
    "cell_identifier_aliases_in_order": ["cell", "cellid", "barcode", "barcodes", "rownames"],
    "cell_type_aliases_in_order": ["celltypel1", "celltype", "majorcelltype", "annotation", "clusterannotation"],
    "sample_identifier_aliases_in_order": ["sample", "sampleid", "samplename", "origident", "individual", "individualid", "patient", "patientid", "donor", "donorid"],
    "condition_aliases_in_order": ["disease", "diseasestatus", "condition", "group", "status", "studyclassification", "sampletype"],
    "tissue_aliases_in_order": ["tissue", "tissuetype", "source", "sourcename"],
    "resolution_rule": "select the first exact normalized alias match; refuse zero or multiple source columns for the selected alias",
    "manual_column_choice_after_access": "forbidden"
  },
  "population_contract": {
    "include_only_sample_metadata_rows_author_designated_as_healthy_control": true,
    "include_only_PBMC_tissue": true,
    "join_cell_annotation_to_barcodes_and_sample_metadata_by_author_identifiers_only": true,
    "minimum_distinct_healthy_donors": 5,
    "cells_are_not_independent_biological_replicates": true,
    "donor_is_the_reporting_and_inference_unit": true
  },
  "expression_contract": {
    "raw_integer_counts_only": true,
    "normalization": "per-cell library size to 10000 followed by log1p",
    "gene_alignment": "exact case-sensitive HGNC symbol intersection in original 508-feature order",
    "minimum_common_features": 450,
    "feature_selection_or_weight_fitting_on_GSE158055": false,
    "minimum_library_size": 1,
    "duplicate_cell_identifiers": "refuse",
    "duplicate_gene_symbols": "use first released row in source order and report"
  },
  "coarse_cell_type_mapping_in_order": [
    {"canonical": "B_cell", "case_insensitive_patterns": ["(^|[^a-z])b([^a-z]|$)", "b cell", "b-cell", "cd19", "cd20"]},
    {"canonical": "CD4_T_cell", "case_insensitive_patterns": ["cd4", "helper t", "regulatory t", "treg"]},
    {"canonical": "CD8_T_cell", "case_insensitive_patterns": ["cd8", "cytotoxic t"]},
    {"canonical": "NK_cell", "case_insensitive_patterns": ["(^|[^a-z])nk([^a-z]|$)", "natural killer"]},
    {"canonical": "monocyte", "case_insensitive_patterns": ["mono", "cd14", "cd16"]},
    {"canonical": "dendritic_cell", "case_insensitive_patterns": ["dendritic", "(^|[^a-z])dc([^a-z]|$)", "pdc"]}
  ],
  "label_policy": {
    "generic_T_without_CD4_or_CD8": "exclude",
    "unassigned_or_unknown": "exclude",
    "outside_six_class_ontology": "semantic_OOD_only",
    "manual_marker_relabeling": "forbidden",
    "predicted_label_as_truth": "forbidden"
  },
  "single_use_endpoints": {
    "macro_f1_minimum": 0.70,
    "ece_15_bin_maximum": 0.15,
    "marginal_conformal_coverage_minimum": 0.90,
    "class_conditional_coverage_minimum_for_classes_with_at_least_100_cells": 0.80,
    "mean_prediction_set_size_maximum": 3.0,
    "semantic_ood_auroc_minimum_if_at_least_100_positive_and_100_negative_cells": 0.70,
    "all_metrics_reported_by_donor": true,
    "confirmation_labels_may_change_nothing": true
  },
  "failure_policy": {
    "missing_required_raw_or_author_label_axis": "refuse without substitution",
    "any_primary_endpoint_failure": "retain blocked_external_uncertainty and retire GSE158055 from future pristine use",
    "next_attempt_after_failure": "new preregistration and a new untouched laboratory"
  },
  "authority": {
    "role": "pre_sweep_context_compression_only",
    "aleph_parameter_authority": "none",
    "may_delete_sweep_axis": false,
    "may_emit_numeric_sweep_range": false,
    "may_select_aleph_parameter": false
  }
}
