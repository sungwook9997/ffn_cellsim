{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-aleph.invalid/schemas/external-training-extraction-record-v1.json",
  "title": "Proposed external-training JATS retrieval chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority_status", "source_family_id", "pmcid", "payload_sha256", "article_locator", "section_locator", "section_class", "chunk_ordinal", "chunk_sha256", "text_sha256", "text", "tags"],
  "properties": {
    "schema": {"const": "aleph.external_training.jats_chunk.v1"},
    "authority_status": {"const": "proposed"},
    "source_family_id": {"type": "string", "minLength": 1},
    "pmcid": {"type": "string", "pattern": "^PMC[0-9]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "article_locator": {"type": "string", "minLength": 1},
    "section_locator": {"type": "string", "minLength": 1},
    "section_title": {"type": "string"},
    "section_class": {"enum": ["abstract", "introduction", "methods", "results", "discussion", "conclusion", "supplementary", "figure_caption", "table_caption", "other"]},
    "chunk_ordinal": {"type": "integer", "minimum": 0},
    "chunk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_type_state", "measurement_modality", "mechanics_observable", "perturbation"],
      "properties": {
        "cell_type_state": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "measurement_modality": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mechanics_observable": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "perturbation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
