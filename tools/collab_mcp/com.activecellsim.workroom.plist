<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ACS Collab Workroom — user LaunchAgent.

  This file is a TEMPLATE: the literal token __REPO_ROOT__ is substituted
  at install time by tools/collab_mcp/install_launchd.sh. Do not load this
  template directly with launchctl; let the installer write the rendered
  copy into ~/Library/LaunchAgents/.

  Behavior:
    - RunAtLoad = true: fires once at user login.
    - KeepAlive = false: the .command is idempotent and exits after
      kicking off the persistent processes (room.py / tmux relay / tmux
      work sessions); KeepAlive would respawn it in a loop.
    - All output redirected to /tmp/acs-collab/launchd.{out,err} so a
      bad boot never bloats the user log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.activecellsim.workroom</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>__REPO_ROOT__/tools/collab_mcp/launch_workroom_mac.command</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/acs-collab/launchd.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/acs-collab/launchd.err</string>

    <!--
      EnvironmentVariables — substituted at install time by
      install_launchd.sh. Pinning COLLAB_MCP_PYTHON in plist (rather than
      depending on the user's interactive zshenv being loaded) prevents
      the boot-time fallback to /usr/bin/python3 that caused the silent
      ModuleNotFoundError on 2026-05-02. COLLAB_MCP_TOKEN is also pinned
      here so the launcher's MCP-server step is never gated on a shell
      rc-file the launchd job does not source.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>COLLAB_MCP_PYTHON</key>
        <string>__REPO_ROOT__/.venv-collab/bin/python</string>
        <key>COLLAB_MCP_TOKEN</key>
        <string>__COLLAB_MCP_TOKEN__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
