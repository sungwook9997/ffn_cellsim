# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/

# Environments
.venv/
.venv-collab/
venv/
env/

# Run artifacts (CLAUDE.md mandates per-run config + git hash capture, but the
# bulk frame data should NOT enter version control)
logs/
results/
*.h5
*.hdf5
frames/

# Layer-2 B2 native-N GPU sweep output (per-(N0,seed) JSON-lines run records). These are
# run-artifact data synced via Syncthing/outputs, not source; provenance is stamped INSIDE
# each line (commit + cfg hash), so the data belongs to outputs, not version control.
ffn_sim/outputs/layer2/b2_gpu/*.jsonl

# PI experimental imaging input (V2-1 contract input — symlinks to local
# disk path, see docs/v2_layer_1_imaging_input_contract*.md). Bulk imaging
# data (mask PNG, raw stacks, ND2/CZI/TIFF) MUST NOT enter version control.
data/experimental/imaging/
*.tif
*.tiff
*.ome.tif
*.nd2
*.czi
*.lif

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Taichi caches
.taichi/

# Notebook checkpoints
.ipynb_checkpoints/

# Claude Code local session settings + per-host worktrees
.claude/settings.local.json
.claude/worktrees/

# Syncthing folder marker
.stfolder/

# Syncthing / editor conflict byproducts (never project state)
*.sync-conflict-*
.syncthing.*.tmp
~$*

# acs-collab MCP ledger — append-only mirror of the message queue, shared via
# Syncthing (not git). Every send rewrites it, so tracking it would generate
# noisy diffs without adding history beyond what the SQLite DB already stores.
docs/claude_codex_log.md

# Local code-review-graph SQLite cache. Rebuild with:
#   .venv-collab/bin/code-review-graph build --repo .
.code-review-graph/

# Notion export token (never commit) + Obsidian vault internals
**/.notion_token
ffn_sim/.obsidian/
ffn_sim/outputs/.obsidian/
.baoab_probe.json

# Obsidian RAG export — vault is regeneratable from the scripts (do not commit)
ffn_sim/outputs/obsidian_rag_full/vault/
ffn_sim/outputs/obsidian_rag_demo/vault/

# TAG (Table-Augmented Generation) backend — kb.duckdb regenerable via refresh.sh
ffn_sim/outputs/tag_kb/kb.duckdb
ffn_sim/outputs/tag_kb/pass2_dossiers.json
# presentation HTML — regenerable from KB_PRESENTATION.md + figs via export_html.py
# (base64-embeds the committed PNGs; don't double-store them in git)
ffn_sim/outputs/tag_kb/presentation/KB_PRESENTATION.html

# Reference PDF corpus — large binaries, synced via Syncthing not git
# (the lightweight index tag_corpus.json + analysis/_manifest.json stay tracked)
ffn_sim/references/*.pdf
ffn_sim/references/**/*.pdf
ffn_sim/references/*.zip
ffn_sim/references/**/*.bak_*

# PI experimental data (poster A/A0 exports) — overlay-only, kept LOCAL (hard rule: PI
# experimental data is not committed; lives in ~/ActiveCellSim/data/experimental). Used by
# the A2 overlay at comparison time; figures (the sanctioned overlay) ARE committed.
ffn_sim/references/260313_*.csv

# Layer-2 production run artifacts (Syncthing/outputs, provenance-stamped)
ffn_sim/outputs/layer2/prod_rlaw/*.jsonl
ffn_sim/outputs/layer2/prod_rlaw/*.log
ffn_sim/outputs/layer2/prod_rlaw/*.err
ffn_sim/outputs/layer2/prod_rlaw/*.progress
ffn_sim/outputs/layer2/prod_rlaw/*.out

ffn_sim/outputs/layer2/decisive/*.jsonl
ffn_sim/outputs/layer2/decisive/*.log
ffn_sim/outputs/layer2/decisive/*.err
ffn_sim/outputs/layer2/decisive/*.progress

ffn_sim/outputs/layer2/daxis*/*.jsonl
ffn_sim/outputs/layer2/daxis*/*.err
ffn_sim/outputs/layer2/daxis*/*.progress

# KU-3.5 driver checkpoints (run state, not artifacts)
ffn_sim/outputs/h3/production/ku35_active/ckpt/
ffn_sim/outputs/layer2/morphology_frames.npz

# Production bulk trajectories / frame dumps. Curated REPORT.md, PNG figures,
# and selected JSON/NPZ summaries remain visible for explicit commit decisions.
ffn_sim/outputs/**/*.log
ffn_sim/outputs/**/*.err
ffn_sim/outputs/**/*.progress
ffn_sim/outputs/**/*.out
ffn_sim/outputs/**/*.bak_*
ffn_sim/outputs/**/production/**/*.gsd
# All production .npz are bulk trajectory/state dumps (14-15 MB each); curated
# summaries live as .json/.md and stay visible. Keep ALL production .npz out of git.
ffn_sim/outputs/**/production/*.npz
ffn_sim/outputs/**/production/**/*.npz

# Production run-state markers + local session config (not project deliverables;
# curated summaries/figures are committed explicitly).
ffn_sim/outputs/**/*.status
.claude/

# CuPy/CUDA on-disk compilation cache (build artifact, regenerated on demand).
ffn_sim/outputs/cupy_cache/

# DCM lamellipodium-viz render cache (regenerable from the sim; do not commit)
ffn_sim/outputs/**/_lamel_cache_*.pkl

# two-stage / dt-sweep / blow-up-capture data pickles (regenerable; large gbook
# outputs — frames behind the committed figures, not source).
ffn_sim/outputs/h_dcm_two_stage/*.pkl

# stray sim scratch (Cytosim/force dumps) — never commit
force.txt
messages.cmo
*.cmo

# --- 2026-07-06 outputs cleanup (PI: "모두 정리 + github 새로 정리") ---
# Raw run-output frame data under outputs/ (regenerable; NOT source). Parity-oracle
# fixtures under ffn_sim/dcm/fixtures/*.npz and already-tracked curated outputs npz
# stay tracked (git keeps tracked files); this only stops NEW multi-GB raw dumps.
ffn_sim/outputs/**/*.npz
# Oversized full-frame HTML viewers (>80MB — exceed GitHub's 100MB hard file limit;
# regenerable from npz). The lightweight INTERACTIVE / curated viewers ARE committed.
ffn_sim/outputs/warp_decohesion/figs/n1000_divfix_ipc_24h.html
ffn_sim/outputs/warp_decohesion/figs/n100_divfix_24h.html
ffn_sim/outputs/warp_decohesion/figs/n100_realistic_24h.html

# --- 2026-07-13 FF native full-res HTML viewers + scratch (working-tree cleanup) ---
# FF cell/ECM HTML viewers under outputs/ff/figs/ are native full-res — 264-485 MB each
# (5.8 GB untracked total). Regenerable from the run; the committed record is the PNG
# figures + curves + JSON data (PI native-viewer rule). Large morphology viewers are
# release-uploaded for the gh-pages gallery, not git; lightweight demo HTMLs here are
# dev scratch. The 14 already-tracked HTMLs stay tracked — this only stops NEW ones.
ffn_sim/outputs/ff/figs/*.html
# underscore-prefixed scratch/diagnostic dumps (convention) + TAG query scratch txt
ffn_sim/outputs/ff/figs/_*
ffn_sim/outputs/tag_kb/_*.txt

# --- 2026-07-06 secret hardening (repo is public) — never commit credentials ---
*.env
.env.*
**/.notion_token
*.notion_token
*_token
*.key
*.pem
*.p12
id_rsa
id_ed25519
secrets.*
credentials.*
*.secret
