# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/

# Environments
.venv/
.venv-collab/
venv/
env/

# Run artifacts (CLAUDE.md mandates per-run config + git hash capture, but the
# bulk frame data should NOT enter version control)
logs/
results/
*.h5
*.hdf5
frames/

# Layer-2 B2 native-N GPU sweep output (per-(N0,seed) JSON-lines run records). These are
# run-artifact data synced via Syncthing/outputs, not source; provenance is stamped INSIDE
# each line (commit + cfg hash), so the data belongs to outputs, not version control.
ffn_sim/outputs/layer2/b2_gpu/*.jsonl

# PI experimental imaging input (V2-1 contract input — symlinks to local
# disk path, see docs/v2_layer_1_imaging_input_contract*.md). Bulk imaging
# data (mask PNG, raw stacks, ND2/CZI/TIFF) MUST NOT enter version control.
data/experimental/imaging/
*.tif
*.tiff
*.ome.tif
*.nd2
*.czi
*.lif

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Taichi caches
.taichi/

# Notebook checkpoints
.ipynb_checkpoints/

# Claude Code local session settings + per-host worktrees
.claude/settings.local.json
.claude/worktrees/

# Syncthing folder marker
.stfolder/

# acs-collab MCP ledger — append-only mirror of the message queue, shared via
# Syncthing (not git). Every send rewrites it, so tracking it would generate
# noisy diffs without adding history beyond what the SQLite DB already stores.
docs/claude_codex_log.md

# Local code-review-graph SQLite cache. Rebuild with:
#   .venv-collab/bin/code-review-graph build --repo .
.code-review-graph/

# Notion export token (never commit) + Obsidian vault internals
**/.notion_token
ffn_sim/.obsidian/
ffn_sim/outputs/.obsidian/
.baoab_probe.json

# Obsidian RAG export — vault is regeneratable from the scripts (do not commit)
ffn_sim/outputs/obsidian_rag_full/vault/
ffn_sim/outputs/obsidian_rag_demo/vault/

# TAG (Table-Augmented Generation) backend — kb.duckdb regenerable via refresh.sh
ffn_sim/outputs/tag_kb/kb.duckdb
ffn_sim/outputs/tag_kb/pass2_dossiers.json

# Reference PDF corpus — large binaries, synced via Syncthing not git
# (the lightweight index tag_corpus.json + analysis/_manifest.json stay tracked)
ffn_sim/references/*.pdf
ffn_sim/references/**/*.pdf
ffn_sim/references/*.zip

# PI experimental data (poster A/A0 exports) — overlay-only, kept LOCAL (hard rule: PI
# experimental data is not committed; lives in ~/ActiveCellSim/data/experimental). Used by
# the A2 overlay at comparison time; figures (the sanctioned overlay) ARE committed.
ffn_sim/references/260313_*.csv

# Layer-2 production run artifacts (Syncthing/outputs, provenance-stamped)
ffn_sim/outputs/layer2/prod_rlaw/*.jsonl
ffn_sim/outputs/layer2/prod_rlaw/*.log
ffn_sim/outputs/layer2/prod_rlaw/*.err
ffn_sim/outputs/layer2/prod_rlaw/*.progress
ffn_sim/outputs/layer2/prod_rlaw/*.out

ffn_sim/outputs/layer2/decisive/*.jsonl
ffn_sim/outputs/layer2/decisive/*.log
ffn_sim/outputs/layer2/decisive/*.err
ffn_sim/outputs/layer2/decisive/*.progress

ffn_sim/outputs/layer2/daxis*/*.jsonl
ffn_sim/outputs/layer2/daxis*/*.err
ffn_sim/outputs/layer2/daxis*/*.progress
