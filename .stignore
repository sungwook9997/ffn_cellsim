// Syncthing ignore patterns for ActiveCellSim
// See https://docs.syncthing.net/users/ignoring.html

// --- git internals (per-host, never sync) ---
.git
.gitignore.local

// --- Claude Code per-host worktrees & session state ---
.claude

// --- Python build / cache (per-host, regeneratable) ---
__pycache__
*.py[cod]
*.egg-info
.eggs
.pytest_cache
.pytest_tmp
.ruff_cache

// --- venvs (per-host, never sync) ---
.venv
venv
env

// --- Taichi JIT cache (per-host, GPU-arch specific) ---
.taichi

// --- Editor / OS junk ---
.vscode
.idea
.DS_Store
Thumbs.db
.ipynb_checkpoints

// --- Build artifacts ---
build
dist

// Note: data/experimental/ and data/literature/ ARE synced (small CSVs).
// Note: results/ IS synced for now — toggle below if HDF5 frames balloon.
// results
// logs
